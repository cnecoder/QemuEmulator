# 路由容器（损伤中心）: L3 转发 + tc netem + 损伤控制守护（wm_router_ctl.py）
FROM ubuntu:26.04
RUN apt-get update && apt-get install -y --no-install-recommends \
        iproute2 iptables python3 \
    && rm -rf /var/lib/apt/lists/*
COPY router-setup.sh /router-setup.sh
COPY wm_router_ctl.py /wm_router_ctl.py
ENTRYPOINT ["bash", "/router-setup.sh"]
